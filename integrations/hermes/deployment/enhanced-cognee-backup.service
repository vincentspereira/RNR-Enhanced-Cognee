[Unit]
Description=Encrypted Enhanced Cognee database backup

[Service]
Type=oneshot
# Operator installs this unit with its own private environment, public age
# recipient and chosen local backup directory. Never point it at a cloud sync
# folder until the owner has selected that destination and checked recovery.
EnvironmentFile=%h/.config/enhanced-cognee/backup.env
ExecStart=%h/.local/share/enhanced-cognee/operator/bin/python -m src.memory_backup create --directory ${ENHANCED_BACKUP_DIRECTORY} --recipient ${ENHANCED_BACKUP_RECIPIENT}
WorkingDirectory=%h/.local/share/enhanced-cognee/repository
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
TimeoutStartSec=15min
