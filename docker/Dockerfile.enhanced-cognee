# RNR Enhanced Cognee Dockerfile
# Integrates RNR Enhanced Cognee with enterprise-grade memory stack
# Replaces default databases: SQLite->PostgreSQL, LanceDB->Qdrant, Kuzu->Neo4j, adds Redis

FROM python:3.12.15-slim-trixie

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    jq \
    wget \
    git \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements-build.lock /app/
RUN pip install --no-cache-dir --require-hashes -r requirements-build.lock
COPY requirements-full.lock /app/
RUN pip install --no-cache-dir --require-hashes -r requirements-full.lock
RUN python -m pip check && python -m pip uninstall -y pip

# Copy RNR Enhanced Cognee application code
COPY src/ /app/src/
COPY bin/ /app/bin/
COPY cognee/ /app/cognee/
COPY distributed/ /app/distributed/
COPY alembic_enhanced/ /app/alembic_enhanced/
COPY migrations/ /app/migrations/
COPY alembic/ /app/alembic/
COPY alembic.ini /app/
COPY alembic-enhanced.ini /app/
COPY config/ /app/config/

# Copy initialization scripts
COPY docker/scripts/ /app/scripts/

# Set environment variables for Enhanced Stack
# PYTHONPATH=/app so the `src` package resolves (module is src.enhanced_cognee_mcp:app).
ENV PYTHONPATH=/app
ENV ENHANCED_COGNEE_MODE=true
ENV ENHANCED_ENV=production ENHANCED_REQUIRE_TENANT=1
ENV LOG_LEVEL=INFO
ENV PYTHONUNBUFFERED=1
ENV COGNEE_LOG_FILE=false ENHANCED_LOAD_DOTENV=0 COGNEE_TELEMETRY_ENABLED=0

# Create a non-root user and make the runtime data/log dirs writable by it.
RUN groupadd --system appuser \
    && useradd --system --gid appuser --create-home --home-dir /home/appuser appuser \
    && mkdir -p /app/data /app/logs /app/tmp \
    && chown -R appuser:appuser /app/data /app/logs /app/tmp

# Drop privileges -- the app runs as the unprivileged appuser.
RUN find / -xdev -type f -perm /6000 -exec chmod a-s {} +
USER appuser

# Expose port
EXPOSE 8080

# Health check -- liveness endpoint (200 while the process is up).
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8080/health/live || exit 1

# Start the RNR Enhanced Cognee FastAPI app. NO --reload in production.
CMD ["python", "-m", "uvicorn", "src.enhanced_cognee_mcp:app", "--host", "0.0.0.0", "--port", "8080"]
